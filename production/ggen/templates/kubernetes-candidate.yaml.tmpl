# Generated by ggen from receipt-addressed DfCM candidate {{ sha }}.
# CONSTRUCT ONLY. Applying this file is a separate authorized act.
# Artifact digest is intentionally non-runnable until release evidence binds it.

apiVersion: v1
kind: Namespace
metadata:
  name: ash-r2rml
  labels:
    app.kubernetes.io/name: ash-r2rml
    ash-r2rml/candidate-sha256: "{{ sha }}"
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny
  namespace: ash-r2rml
spec:
  podSelector: {}
  policyTypes: ["Ingress", "Egress"]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: production-candidate
  namespace: ash-r2rml
data:
  candidate_sha256: "{{ sha }}"
  deployment_topology: "{{ topology }}"
  execution_mode: "{{ execution }}"
  control_plane: "{{ control_plane }}"
  tenancy_model: "{{ tenancy }}"
  data_residency: "{{ residency }}"
  release_strategy: "{{ release }}"
  secret_delivery: "{{ secret_delivery }}"
  observability: "{{ observability }}"
  recovery_strategy: "{{ recovery }}"
  runtime_isolation: "{{ runtime_isolation }}"
  authority: "construct-only"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: compiler
  namespace: ash-r2rml
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: compiler
  namespace: ash-r2rml
  labels: &compiler_labels
    app.kubernetes.io/name: ash-r2rml
    ash-r2rml/role: compiler
spec:
  replicas: 2
  selector:
    matchLabels: *compiler_labels
  template:
    metadata:
      labels: *compiler_labels
    spec:
      serviceAccountName: compiler
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: compiler
          image: "REQUIRED_BY_SIGNED_RELEASE_RECEIPT"
          args: ["--role", "compiler"]
          env:
            - {name: ASH_R2RML_CANDIDATE_SHA256, value: "{{ sha }}"}
            - {name: ASH_R2RML_AUTHORITY_CLASS, value: "construct"}
          resources:
            requests: {cpu: "500m", memory: "512Mi"}
            limits: {cpu: "1", memory: "1Gi"}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities: {drop: ["ALL"]}
          readinessProbe:
            httpGet: {path: /health/ready, port: 4000}
          livenessProbe:
            httpGet: {path: /health/live, port: 4000}
---
