{% if execution != "compile_only" %}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: semantic-runtime
  namespace: ash-r2rml
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: semantic-runtime
  namespace: ash-r2rml
  labels: &runtime_labels
    app.kubernetes.io/name: ash-r2rml
    ash-r2rml/role: semantic-runtime
spec:
  replicas: 3
  selector:
    matchLabels: *runtime_labels
  template:
    metadata:
      labels: *runtime_labels
    spec:
      serviceAccountName: semantic-runtime
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: semantic-runtime
          image: "REQUIRED_BY_SIGNED_RELEASE_RECEIPT"
          args: ["--role", "semantic-runtime"]
          env:
            - {name: ASH_R2RML_CANDIDATE_SHA256, value: "{{ sha }}"}
            - {name: ASH_R2RML_AUTHORITY_CLASS, value: "runtime-read"}
          resources:
            requests: {cpu: "1", memory: "1Gi"}
            limits: {cpu: "2", memory: "2Gi"}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities: {drop: ["ALL"]}
          readinessProbe:
            httpGet: {path: /health/ready, port: 4000}
          livenessProbe:
            httpGet: {path: /health/live, port: 4000}
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: semantic-runtime
  namespace: ash-r2rml
spec:
  scaleTargetRef: {apiVersion: apps/v1, kind: Deployment, name: semantic-runtime}
  minReplicas: 3
  maxReplicas: 100
  metrics:
    - type: Resource
      resource:
        name: cpu
        target: {type: Utilization, averageUtilization: 65}
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: semantic-runtime
  namespace: ash-r2rml
spec:
  minAvailable: 2
  selector:
    matchLabels: *runtime_labels
