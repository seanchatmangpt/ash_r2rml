# SPDX-License-Identifier: MIT
# MESSAGE: production manufacture requires one receipt-addressed admitted semantic subject
PREFIX p: <https://w3id.org/ash-r2rml/production#>
ASK {
  FILTER NOT EXISTS {
    p:SemanticSubject a p:AdmittedSemanticSubject ;
      p:sha256 ?sha ;
      p:constructOnly true .
  }
}
