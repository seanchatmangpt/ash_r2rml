# MESSAGE: every reversible design candidate must carry deterministic identity
PREFIX p: <https://w3id.org/ash-r2rml/production#>
ASK {
  ?candidate a p:DesignCandidate .
  FILTER NOT EXISTS { ?candidate p:candidateSha256 ?sha . }
}
