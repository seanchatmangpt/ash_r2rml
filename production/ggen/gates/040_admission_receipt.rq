# MESSAGE: production standing must be receipt-addressed even when incomplete
PREFIX p: <https://w3id.org/ash-r2rml/production#>
ASK {
  p:ProductionAdmission a p:EvidenceAdmission .
  FILTER NOT EXISTS { p:ProductionAdmission p:receiptSha256 ?receipt . }
}
