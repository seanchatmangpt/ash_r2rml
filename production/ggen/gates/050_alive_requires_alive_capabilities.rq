# MESSAGE: technical ALIVE cannot coexist with an incomplete required capability standing
PREFIX p: <https://w3id.org/ash-r2rml/production#>
ASK {
  p:ProductionAdmission a p:EvidenceAdmission ; p:status "ALIVE" .
  ?standing a p:CapabilityStanding ; p:status ?status .
  FILTER (?status != "ALIVE")
}
