    r2ml:storageStrategy "foreign_key" ; r2ml:sourceKey "brand_id" ; r2ml:destinationKey "id" ; r2ml:inverseName "sites" ]  .

nf:ProviderShape a sh:NodeShape ; sh:targetClass nf:Provider ;
  r2ml:ashModule "NatFac.Facilities.Provider" ; r2ml:domainModule "NatFac.Facilities" ; r2ml:repoModule "NatFac.Repo" ;
  r2ml:tableName "providers" ;
  r2ml:subjectTemplate "https://natfac.example/providers/{id}" ;
  r2ml:stateMachine [ r2ml:stateAttribute "status" ; r2ml:initial "draft" ; r2ml:terminal "terminated" ;
    r2ml:transition [ r2ml:action "submit" ; r2ml:from "draft" ; r2ml:to "under_review" ] ;
    r2ml:transition [ r2ml:action "approve" ; r2ml:from "under_review" ; r2ml:to "approved" ] ;
    r2ml:transition [ r2ml:action "suspend" ; r2ml:from "approved" ; r2ml:to "suspended" ] ;
    r2ml:transition [ r2ml:action "reinstate" ; r2ml:from "suspended" ; r2ml:to "approved" ] ;
    r2ml:transition [ r2ml:action "terminate" ; r2ml:from "approved" ; r2ml:to "terminated" ] ;
    r2ml:transition [ r2ml:action "terminate" ; r2ml:from "suspended" ; r2ml:to "terminated" ] ] ;
  r2ml:action [ r2ml:actionName "register" ; r2ml:actionKind "create" ; r2ml:primary true ; r2ml:accept "party_id,classification,segment,company_name" ] ;
  r2ml:action [ r2ml:actionName "amend" ; r2ml:actionKind "update" ; r2ml:primary true ; r2ml:accept "segment,company_name" ] ;
  r2ml:action [ r2ml:actionName "list" ; r2ml:actionKind "read" ; r2ml:primary true ] ;
  r2ml:action [ r2ml:actionName "search" ; r2ml:actionKind "read" ;
    r2ml:argument [ r2ml:argName "classification" ; r2ml:argType "string" ; r2ml:argAllowNil true ] ] ;
  r2ml:policy [ r2ml:policyName "provider_read" ; r2ml:actionType "read" ; r2ml:authorizeIf "NatFac.Checks.ActorHasCapability" ; r2ml:bypassActor "NatFac.Checks.ActorIsSystem" ] ;
  r2ml:policy [ r2ml:policyName "provider_create" ; r2ml:actionType "create" ; r2ml:authorizeIf "NatFac.Checks.ActorHasCapability" ] ;
  r2ml:policy [ r2ml:policyName "provider_update" ; r2ml:actionType "update" ; r2ml:authorizeIf "NatFac.Checks.ActorHasCapability" ] ;
  r2ml:policy [ r2ml:policyName "provider_destroy" ; r2ml:actionType "destroy" ; r2ml:authorizeIf "NatFac.Checks.ActorHasCapability" ] ;
  r2ml:identity [ r2ml:identityName "primary" ; r2ml:identityKey "id" ; r2ml:primaryIdentity true ] ;
  sh:property [ sh:path nf:id ; r2ml:ashName "id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:classification ; r2ml:ashName "classification" ; sh:in ( "national" "regional" "local" ) ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:segment ; r2ml:ashName "segment" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 0 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:status ; r2ml:ashName "status" ; sh:in ( "draft" "under_review" "approved" "suspended" "terminated" ) ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:company_name ; r2ml:ashName "company_name" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:party_id ; r2ml:ashName "party_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:party ; r2ml:ashName "party" ; sh:class schema:Organization ; sh:minCount 1 ; sh:maxCount 1 ;
    r2ml:storageStrategy "foreign_key" ; r2ml:sourceKey "party_id" ; r2ml:destinationKey "id" ; r2ml:inverseName "providers" ]  .

