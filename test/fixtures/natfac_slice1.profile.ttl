  sh:property [ sh:path nf:id ; r2ml:ashName "id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:site_code ; r2ml:ashName "site_code" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:site_type ; r2ml:ashName "site_type" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:address ; r2ml:ashName "address" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:state ; r2ml:ashName "state" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:zip ; r2ml:ashName "zip" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:operating_dba_id ; r2ml:ashName "operating_dba_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:brand_id ; r2ml:ashName "brand_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
