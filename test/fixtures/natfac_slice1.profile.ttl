@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix nf: <https://natfac.example/ns#> .
@prefix r2ml: <https://seanchatmangpt.github.io/ash_r2rml#> .

# NatFac slice-1 profile: provider onboarding + alignment.
# Source of truth for domains/resources (manufactured by ash_r2rml via ggen_igniter).
# Slice-1 fixture copy extended with enums, tenancy, actions, policies and a Provider state machine.
# schema:Organization / schema:Place are public IRIs; nf: terms are NOT_FOUND publicly (see docs).

nf:CompanyShape a sh:NodeShape ; sh:targetClass nf:Company ;
  r2ml:ashModule "NatFac.Facilities.Company" ; r2ml:domainModule "NatFac.Facilities" ; r2ml:repoModule "NatFac.Repo" ;
  r2ml:tableName "companies" ;
  r2ml:subjectTemplate "https://natfac.example/companies/{id}" ;
  r2ml:identity [ r2ml:identityName "primary" ; r2ml:identityKey "id" ; r2ml:primaryIdentity true ] ;
  sh:property [ sh:path nf:id ; r2ml:ashName "id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:legal_name ; r2ml:ashName "legal_name" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ]  .

nf:OperatingDbaShape a sh:NodeShape ; sh:targetClass nf:OperatingDba ;
  r2ml:ashModule "NatFac.Facilities.OperatingDba" ; r2ml:domainModule "NatFac.Facilities" ; r2ml:repoModule "NatFac.Repo" ;
  r2ml:tableName "operating_dbas" ;
  r2ml:subjectTemplate "https://natfac.example/operating_dbas/{id}" ;
  r2ml:identity [ r2ml:identityName "primary" ; r2ml:identityKey "id" ; r2ml:primaryIdentity true ] ;
  sh:property [ sh:path nf:id ; r2ml:ashName "id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:name ; r2ml:ashName "name" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:subdomain ; r2ml:ashName "subdomain" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:category ; r2ml:ashName "category" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:status ; r2ml:ashName "status" ; sh:in ( "active" "inactive" ) ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:company_id ; r2ml:ashName "company_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:company ; r2ml:ashName "company" ; sh:class nf:Company ; sh:minCount 1 ; sh:maxCount 1 ;
    r2ml:storageStrategy "foreign_key" ; r2ml:sourceKey "company_id" ; r2ml:destinationKey "id" ; r2ml:inverseName "operating_dbas" ]  .

nf:PartyShape a sh:NodeShape ; sh:targetClass schema:Organization ;
  r2ml:ashModule "NatFac.Facilities.Party" ; r2ml:domainModule "NatFac.Facilities" ; r2ml:repoModule "NatFac.Repo" ;
  r2ml:tableName "parties" ;
  r2ml:subjectTemplate "https://natfac.example/parties/{id}" ;
