  sh:property [ sh:path nf:legal_name ; r2ml:ashName "legal_name" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:ein ; r2ml:ashName "ein" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 0 ; sh:maxCount 1 ]  .

nf:TradeShape a sh:NodeShape ; sh:targetClass nf:Trade ;
  r2ml:ashModule "NatFac.Facilities.Trade" ; r2ml:domainModule "NatFac.Facilities" ; r2ml:repoModule "NatFac.Repo" ;
