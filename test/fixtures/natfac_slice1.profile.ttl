  sh:property [ sh:path nf:parent_trade_id ; r2ml:ashName "parent_trade_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 0 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:parent ; r2ml:ashName "parent" ; sh:class nf:Trade ; sh:minCount 0 ; sh:maxCount 1 ;
    r2ml:storageStrategy "foreign_key" ; r2ml:sourceKey "parent_trade_id" ; r2ml:destinationKey "id" ; r2ml:inverseName "sub_trades" ]  .

nf:ClientShape a sh:NodeShape ; sh:targetClass nf:Client ;
  r2ml:ashModule "NatFac.Facilities.Client" ; r2ml:domainModule "NatFac.Facilities" ; r2ml:repoModule "NatFac.Repo" ;
  r2ml:tableName "clients" ;
  r2ml:subjectTemplate "https://natfac.example/clients/{id}" ;
  r2ml:multitenancy [ r2ml:tenantStrategy "attribute" ; r2ml:tenantAttribute "operating_dba_id" ; r2ml:tenantGlobal false ] ;
  r2ml:identity [ r2ml:identityName "primary" ; r2ml:identityKey "id" ; r2ml:primaryIdentity true ] ;
  sh:property [ sh:path nf:id ; r2ml:ashName "id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:client_type ; r2ml:ashName "client_type" ; sh:in ( "direct" "reseller" ) ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:status ; r2ml:ashName "status" ; sh:in ( "active" "inactive" "suspended" ) ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:party_id ; r2ml:ashName "party_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:party ; r2ml:ashName "party" ; sh:class schema:Organization ; sh:minCount 1 ; sh:maxCount 1 ;
    r2ml:storageStrategy "foreign_key" ; r2ml:sourceKey "party_id" ; r2ml:destinationKey "id" ; r2ml:inverseName "clients" ] ;
  sh:property [ sh:path nf:operating_dba_id ; r2ml:ashName "operating_dba_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:operating_dba ; r2ml:ashName "operating_dba" ; sh:class nf:OperatingDba ; sh:minCount 1 ; sh:maxCount 1 ;
    r2ml:storageStrategy "foreign_key" ; r2ml:sourceKey "operating_dba_id" ; r2ml:destinationKey "id" ; r2ml:inverseName "clients" ] ;
  sh:property [ sh:path nf:contracted_via_client_id ; r2ml:ashName "contracted_via_client_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 0 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:contracted_via ; r2ml:ashName "contracted_via" ; sh:class nf:Client ; sh:minCount 0 ; sh:maxCount 1 ;
    r2ml:storageStrategy "foreign_key" ; r2ml:sourceKey "contracted_via_client_id" ; r2ml:destinationKey "id" ; r2ml:inverseName "downstream_clients" ]  .

