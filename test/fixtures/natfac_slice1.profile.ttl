nf:SiteShape a sh:NodeShape ; sh:targetClass schema:Place ;
  r2ml:ashModule "NatFac.Facilities.Site" ; r2ml:domainModule "NatFac.Facilities" ; r2ml:repoModule "NatFac.Repo" ;
  r2ml:tableName "sites" ;
  r2ml:subjectTemplate "https://natfac.example/sites/{id}" ;
  r2ml:multitenancy [ r2ml:tenantStrategy "attribute" ; r2ml:tenantAttribute "operating_dba_id" ; r2ml:tenantGlobal false ] ;
