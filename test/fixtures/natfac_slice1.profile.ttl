nf:AlignmentLineShape a sh:NodeShape ; sh:targetClass nf:AlignmentLine ;
  r2ml:ashModule "NatFac.Facilities.AlignmentLine" ; r2ml:domainModule "NatFac.Facilities" ; r2ml:repoModule "NatFac.Repo" ;
  r2ml:tableName "alignment_lines" ;
  r2ml:subjectTemplate "https://natfac.example/alignment_lines/{id}" ;
  r2ml:action [ r2ml:actionName "add" ; r2ml:actionKind "create" ; r2ml:primary true ; r2ml:accept "effect,dimension,dimension_value,rank,provider_id,template_id" ] ;
  r2ml:action [ r2ml:actionName "reorder" ; r2ml:actionKind "update" ; r2ml:primary true ; r2ml:accept "rank" ] ;
  r2ml:action [ r2ml:actionName "list" ; r2ml:actionKind "read" ; r2ml:primary true ] ;
  r2ml:identity [ r2ml:identityName "primary" ; r2ml:identityKey "id" ; r2ml:primaryIdentity true ] ;
  sh:property [ sh:path nf:id ; r2ml:ashName "id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:effect ; r2ml:ashName "effect" ; sh:in ( "include" "exclude" ) ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:dimension ; r2ml:ashName "dimension" ; sh:in ( "state" "zip" "trade" "segment" ) ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:dimension_value ; r2ml:ashName "dimension_value" ; r2ml:postgresType "TEXT" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:rank ; r2ml:ashName "rank" ; r2ml:postgresType "INTEGER" ; sh:datatype xsd:integer ; sh:minCount 0 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:provider_id ; r2ml:ashName "provider_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 0 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:provider ; r2ml:ashName "provider" ; sh:class nf:Provider ; sh:minCount 0 ; sh:maxCount 1 ;
    r2ml:storageStrategy "foreign_key" ; r2ml:sourceKey "provider_id" ; r2ml:destinationKey "id" ; r2ml:inverseName "alignment_lines" ] ;
  sh:property [ sh:path nf:template_id ; r2ml:ashName "template_id" ; r2ml:postgresType "UUID" ; sh:datatype xsd:string ; sh:minCount 0 ; sh:maxCount 1 ] ;
  sh:property [ sh:path nf:template ; r2ml:ashName "template" ; sh:class nf:AlignmentTemplate ; sh:minCount 0 ; sh:maxCount 1 ;
    r2ml:storageStrategy "foreign_key" ; r2ml:sourceKey "template_id" ; r2ml:destinationKey "id" ; r2ml:inverseName "lines" ]  .

