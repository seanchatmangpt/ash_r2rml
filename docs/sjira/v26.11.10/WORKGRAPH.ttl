# Canonical RDF for the v26.11.10 milestone on seanchatmangpt/ash_r2rml.
# One sj:WorkOrder per milestone work order, grounded in the admitted HEAD
# commit c395b33a358571d4a90c77e2099df2609a816e2f and working tree features.
# Shape conforms to https://ggen-igniter.dev/ontology/semantic-jira# and
# follows the pattern established in docs/sjira/v26.10.8/WORKGRAPH.ttl.
# Standing is NOT asserted here: it is observed state, projected from the
# per-order court evidence named in each work order. This graph grants
# no authority and claims no standing; standing belongs to independent
# exact-subject courts, not to this document.

sj:WorkOrder a rdfs:Class .
sj:AcceptanceCriterion a rdfs:Class .
sj:Falsifier a rdfs:Class .
sj:DependencyEdge a rdfs:Class .

<#WO-R2RML-261110-01> a sj:WorkOrder ;
    sj:identity "R2RML-261110-01" ;
    dcterms:title "Ontology-First Ash Domain Projection (r2ml:domainModule)" ;
    dcterms:description "Ingest optional r2ml:domainModule literal from SHACL node shapes, validate Elixir module naming syntax in AshR2RML.Admission, persist :domain in SemanticIR.Resource, and project governing Ash.Domain modules grouping member resources." ;
    sj:subject "domain-module-projection" ;
    sj:repository "seanchatmangpt/ash_r2rml" ;
    sj:baseSha "c395b33a358571d4a90c77e2099df2609a816e2f" ;
