    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:promotionRule "verified_by_required_courts_then_receipted" ;
    sj:replayIdentity "sjira-v26.11.10-R2RML-261110-01" ;
    sj:authorityRequirement "NONE" ;
    sj:requiredCourt "compile", "tests" ;
    sj:requiredEvidence "command_exit_codes", "real_output" ;
    sj:acceptanceItem [ a sj:AcceptanceCriterion ; sj:index 0 ; dcterms:description "SHACL profiles specifying r2ml:domainModule synthesize valid Ash.Domain modules with resources registration, and mix test test/ontology_first_domains_test.exs exits 0" ] ;
    sj:falsifierItem [ a sj:Falsifier ; sj:index 0 ; dcterms:description "a shape declaring r2ml:domainModule fails to generate an Ash.Domain module or generates resources with domain: nil" ] ,
                     [ a sj:Falsifier ; sj:index 1 ; dcterms:description "a malformed domain module identifier does not trigger typed refusal REFUSED_UNPROVEN_EQUIVALENCE" ] ;
    sj:projection "jira", "verification" ;
    sj:pathScope "lib/ash_r2rml/ingestion.ex lib/ash_r2rml/semantic_ir.ex lib/ash_r2rml/admission.ex lib/ash_r2rml/semantic_renderers.ex test/fixtures/natfac.profile.ttl test/ontology_first_domains_test.exs" .

