#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 ash_r2rml contributors <https://github.com/seanchatmangpt/ash_r2rml/graphs/contributors>
#
# SPDX-License-Identifier: MIT
#
# Mutation court (non-vacuity). Each mutation breaks one guard in place; the named test file
# must then FAIL. A test that still passes under mutation is VACUOUS_TEST_DETECTED (exit 1).
# Every mutation is restored (git checkout -- <file>, or rm for a created file) and the tree is
# re-verified clean before the next one. After restore the test file must pass again.
#
# Exit codes: 0 all mutations killed, tree clean | 1 vacuous test or red baseline
#             2 dirty tree at preflight          | 3 mutation did not apply
#             4 restore left the tree dirty      | 5 final git diff not empty

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 2

export MIX_ENV=test

IN_MEMORY="lib/ash_r2rml/obda_in_memory.ex"
OBDA="lib/ash_r2rml/obda.ex"
QUERY_BUILDER="lib/ash_r2rml/query_builder.ex"
PREFLIGHT="lib/ash_r2rml/obda/preflight.ex"
SECURITY="lib/ash_r2rml/security.ex"
DATATYPE="lib/ash_r2rml/datatype_registry.ex"
MIX_EXS="mix.exs"
REACTOR_TEST="test/reactor_semantic_test.exs"
OFFENDER="lib/ash_r2rml/ontop_mutant.ex"

CURRENT_FILE=""
CURRENT_KIND=""

restore_current() {
  if [ -n "$CURRENT_FILE" ]; then
    if [ "$CURRENT_KIND" = "created" ]; then
      rm -f -- "$CURRENT_FILE"
    else
      git checkout -- $CURRENT_FILE
    fi
    CURRENT_FILE=""
    CURRENT_KIND=""
  fi
}

trap restore_current EXIT INT TERM

porcelain_empty() {
  [ -z "$(git status --porcelain)" ]
}

if ! porcelain_empty; then
  echo "PREFLIGHT_DIRTY: git status --porcelain is not empty; commit or clean first" >&2
  git status --porcelain >&2
  exit 2
fi

# mutate <id> <description> <file[ file...]> <test-file> <perl-substitution-or-:create:>
# (several space-separated files get the same substitution; it must change at least one)
mutate() {
  local id="$1" description="$2" file="$3" test_file="$4" edit="$5"

  echo "== $id: $description"

  CURRENT_FILE="$file"
  if [ "$edit" = ":create:" ]; then
    CURRENT_KIND="created"
    cat >"$file" <<'EOF'
defmodule AshR2RML.OntopMutant do
  @moduledoc false
end
EOF
  else
    CURRENT_KIND="edited"
    perl -pi -e "$edit" $file
  fi

  if [ "$CURRENT_KIND" = "edited" ] && git diff --quiet -- $file; then
    echo "MUTATION_NOT_APPLIED: $id left $file unchanged" >&2
    exit 3
  fi

  mix test "$test_file" --seed 0 --max-failures 1
  local mutated_rc=$?

  restore_current

  if ! porcelain_empty; then
    echo "RESTORE_DIRTY: $id left the tree dirty" >&2
    git status --porcelain >&2
    exit 4
  fi

  if [ "$mutated_rc" -eq 0 ]; then
    echo "VACUOUS_TEST_DETECTED: $id ($description): $test_file passed under mutation" >&2
    exit 1
  fi

  # A deleted mutant source leaves its module in the stale .app modules list: rebuild before the baseline.
  mix compile --force >/dev/null 2>&1
  mix test "$test_file" --seed 0 --max-failures 1
  local baseline_rc=$?
  if [ "$baseline_rc" -ne 0 ]; then
    echo "BASELINE_RED: $test_file fails after restoring $id (rc=$baseline_rc)" >&2
    exit 1
  fi

  echo "KILLED: $id ($description) -> $test_file failed under mutation, passes after restore"
}

# M1: sensitive/forbidden-field omission. Forbidden or sensitive data must be omitted/refused.
mutate M1a "field-policy omission (readable/1 leaks ForbiddenField)" \
  "lib/ash_r2rml/obda_in_memory/iri_template.ex" test/obda_in_memory_field_policy_denial_test.exs \
  's/^(\s*)def readable\(%Ash\.ForbiddenField\{\}\), do: nil/$1def readable(%Ash.ForbiddenField{}), do: "MUTANT-LEAK"/'

mutate M1b "sensitive_attribute?/2 always false (sensitive attribute materialized)" \
  "$IN_MEMORY" test/obda_in_memory_sensitive_coverage_test.exs \
  's/%\{sensitive\?: true\} -> true/%{sensitive?: true} -> false/;s/attr\.sensitive\? == true and/attr.sensitive? == :mutant and/'

mutate M1c "Security sensitive-attribute detection never matches" \
  "$SECURITY" test/security_sensitive_compile_path_test.exs \
  's/match\?\(%\{sensitive\?: true\}/match?(%{sensitive?: :mutant}/'

# M2: tenant forwarding drop. Tenant must reach Ash.read.
mutate M2a "tenant dropped from InMemory read options" \
  "$IN_MEMORY" test/obda_in_memory_row_policy_tenant_test.exs \
  's/\[:actor, :tenant, :authorize\?/[:actor, :authorize?/g'

mutate M2b "tenant dropped from OBDA @forwarded read options" \
  "$OBDA" test/obda_query_unauthorized_test.exs \
  's/^(\s*)\@forwarded \[:actor, :tenant, /$1\@forwarded [:actor, /'

# M6: query-builder field-policy guards (admit_attribute + check_field_policy, defense in depth:
# both are mutated together). A field-policy-gated attribute must never be pushed
# down as a data-layer filter (row count would be an oracle on the hidden value).
mutate M6 "field-policy pushdown guard replaced by a tautology" \
  "$QUERY_BUILDER lib/ash_r2rml/query_builder/lowering.ex" test/obda_field_policy_filter_oracle_test.exs \
  's/false <- AshR2RML\.Security\.field_policy_protected\?\(resource, attribute\) do/true <- is_atom(attribute) do/;s/if AshR2RML\.Security\.field_policy_protected\?\(resource, name\) do/if name == :__never_a_field__ do/'

# M7: preflight must forward the caller's :context to Ash.can?/3.
mutate M7 "preflight drops :context" \
  "$PREFLIGHT" test/obda_preflight_context_test.exs \
  's/\|> put_context\(Keyword\.get\(opts, :context\)\)/|> put_context(nil)/'

# M8: refusal evidence must stay bounded (resource + error class only).
mutate M8 "read refusal evidence leaks the raw error" \
  "$IN_MEMORY" test/obda_refusal_evidence_redaction_test.exs \
  's/error_class: inspect\(class\)\}/error_class: inspect(class), raw: inspect(error)}/'

# M3: max_rows bound removal and datatype Range refusal.
mutate M3a "max_rows surplus check disabled" \
  "$IN_MEMORY" test/obda_in_memory_limits_test.exs \
  's/length\(rows\) > max_rows/length(rows) > max_rows * 1_000_000/'

mutate M3b "Ash.Type.Range admitted by the datatype registry" \
  "$DATATYPE" test/datatype_registry_coverage_test.exs \
  's/("Elixir\.Ash\.Type\.Module" => :module)\s*$/$1, "Elixir.Ash.Type.Range" => :string/'

# M4: zero-JDBC/dep guard. ash_sqlite moved out of only: :test must trip the deps guard.
mutate M4a "ash_sqlite dependency no longer test-only" \
  "$MIX_EXS" test/zero_jdbc_and_deps_guard_test.exs \
  's/\{:ash_sqlite, "~> 0\.2", only: \[:test\]\}/{:ash_sqlite, "~> 0.2"}/'

# M4b: a lib module named *Ontop* must trip the zero-JDBC guard.
mutate M4b "Ontop-named module added under lib/" \
  "$OFFENDER" test/zero_jdbc_guard_test.exs ":create:"

# M5: removing Reactor undo compensation must leave stale triples.
mutate M5 "reactor undo(:always) neutered, compensation never runs" \
  "$REACTOR_TEST" test/reactor_semantic_test.exs \
  's/undo\(:always\)/undo(:never)/'

# M9: SSRF host vet. Private addresses and localhost names must be refused.
mutate M9a "SSRF vet_addrs admits private addresses" \
  "lib/ash_r2rml/sparql/protocol/host.ex" test/sparql_private_network_test.exs \
  's/private -> \{:private, private\}/_private -> :ok/'

mutate M9b "SSRF vet_host admits localhost names" \
  "lib/ash_r2rml/sparql/protocol/host.ex" test/sparql_private_network_test.exs \
  's/^(\s*)\{:private, \[\{127, 0, 0, 1\}\]\}/$1:ok/'

# M10: private-ETS guard fails closed (introspection failure and positive private detection).
mutate M10a "private_ets/1 introspection failure fails open" \
  "$OBDA" test/followup_private_ets_failclosed_test.exs \
  's/(KeyError\] -> ):unknown/$1false/'

mutate M10b "private_ets/1 no longer detects a private ETS table" \
  "$OBDA" test/obda_contract_fixes_test.exs \
  's/(Ets\.Info\.private\?\(resource\) == true -> ):private/$1false/'

# M11: security.ex sanitizers.
mutate M11a "in-memory non-attribute fields no longer excluded" \
  "$SECURITY" test/obda_in_memory_cloak_test.exs \
  's/remove_attributes\(mapping, &1, :in_memory_non_attribute_excluded_attributes\)/remove_attributes(mapping, [], :in_memory_non_attribute_excluded_attributes)/'

mutate M11b "sanitize_mapping never strips field-policy attributes" \
  "$SECURITY" test/security_ash_postgres_test.exs \
  's/if AshR2RML\.DataLayer\.backend\(ash_resource\) != :ets do/if false do/'

# M12: result bounds.
mutate M12a "Sparql.bound/3 max_rows guard disabled" \
  "lib/ash_r2rml/sparql.ex" test/sparql_result_parity_test.exs \
  's/if length\(rows\) > max_rows do/if length(rows) > max_rows * 1_000_000 do/'

mutate M12b "merged GRAPH ?g bound_merged guard disabled" \
  "$IN_MEMORY" test/followup_graph_max_rows_test.exs \
  's/is_integer\(max_rows\) and length\(rows\) > max_rows do/is_integer(max_rows) and length(rows) > max_rows * 1_000_000 do/'

mutate M12c "per-graph local_opts drops max_rows" \
  "$IN_MEMORY" test/followup_graph_max_rows_test.exs \
  's/\[max_rows: Keyword\.get\(read_opts, :max_rows\) \|\| \@default_max_rows\]/[]/'

# M13: federated protocol client hardening (no redirects, http/https only, host vet, row bound).
PROTOCOL="lib/ash_r2rml/sparql/protocol.ex"

mutate M13a "no-redirect client re-enables autoredirect" \
  "$PROTOCOL" test/sparql_protocol_hardening_test.exs \
  's/Keyword\.put\(:autoredirect, false\)/Keyword.put(:autoredirect, true)/'

mutate M13b "endpoint scheme check admits ftp" \
  "$PROTOCOL" test/sparql_protocol_hardening_test.exs \
  's/^(\s*when scheme in \[)"http", "https"(\] and is_binary\(host\) and host != "" ->)/$1"http", "https", "ftp"$2/'

mutate M13c "endpoint host vet skipped (private hosts always admitted)" \
  "$PROTOCOL" test/sparql_private_network_test.exs \
  's/if allow_private == true, do: :ok, else: vet_endpoint_host\(endpoint, host\)/:ok/'

mutate M13d "federated Result.bound max_rows guard disabled" \
  "$PROTOCOL" test/sparql_result_parity_test.exs \
  's/Result\.bound\(endpoint, max_rows\)/Result.bound(endpoint, max_rows * 1_000_000)/'

# M14: fail-closed refusals (endpoint userinfo/fragment/query, unresolved DNS, triple budget).
mutate M14a "endpoint userinfo/fragment/query refusal clause never matches" \
  "$PROTOCOL" test/sparql_protocol_hardening_test.exs \
  's/\(userinfo != nil or fragment != nil or query != nil\) ->/userinfo == :mutant ->/'

mutate M14b "SSRF vet_addrs admits an unresolved (empty) address list" \
  "lib/ash_r2rml/sparql/protocol/host.ex" test/sparql_private_network_test.exs \
  's/defp vet_addrs\(\[\]\), do: :unresolved/defp vet_addrs([]), do: :ok/'

mutate M14c "triple-budget clamp refusal disabled" \
  "$IN_MEMORY" test/followup_triple_clamp_test.exs \
  's/clamp\? and length\(rows\) >= triple_cap ->/clamp? and length(rows) >= triple_cap * 1_000_000 ->/'

if ! git diff --exit-code >/dev/null; then
  echo "FINAL_DIFF_NOT_EMPTY: tracked files differ after the court" >&2
  git diff --stat >&2
  exit 5
fi

if ! porcelain_empty; then
  echo "FINAL_TREE_DIRTY after the court" >&2
  git status --porcelain >&2
  exit 4
fi

echo "MUTATION_COURT_PASS: M1a-M14c (M1abc M2ab M3ab M4ab M5 M6 M7 M8 M9ab M10ab M11ab M12abc M13abcd M14abc) killed, tree clean"
exit 0
