@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix schema: <https://schema.org/> .
<#InvoiceMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "invoices" ] ;
  rr:subjectMap [ rr:template "https://example.org/invoice/{id}" ; rr:class <https://schema.org/Invoice> ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate schema:identifier ; rr:objectMap [ rr:column "id" ] ] .
