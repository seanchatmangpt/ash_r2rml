@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <https://ash-r2rml.dev/vkg/product#> .
ex:ProductMap a rr:TriplesMap ; rr:logicalTable [ rr:tableName "products" ] ; rr:subjectMap [ rr:template "https://ash-r2rml.dev/resource/product/{id}" ; rr:class ex:Product ] ; rr:predicateObjectMap [ rr:predicate ex:sourceId ; rr:objectMap [ rr:column "id" ] ] .
