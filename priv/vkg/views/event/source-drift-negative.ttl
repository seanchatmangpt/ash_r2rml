@prefix vkg: <https://ash-r2rml.dev/vkg#> .
@prefix ex: <https://ash-r2rml.dev/vkg/event#> .
# Negative witness: mutable source identity and malformed digest MUST be refused.
ex:drifted a vkg:FederationContract ; vkg:sourceIdentity "source:event:mutable" ; vkg:sourceSha256 "MUTABLE" ; vkg:mappingSha256 "1111111111111111111111111111111111111111111111111111111111111111" ; vkg:authority "NONE" ; vkg:subjectTemplate "https://ash-r2rml.dev/resource/event/{id}" .
