@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <https://ash-r2rml.dev/vkg/event#> .
ex:EventMap a rr:TriplesMap ; rr:logicalTable [ rr:tableName "events" ] ; rr:subjectMap [ rr:template "https://ash-r2rml.dev/resource/event/{id}" ; rr:class ex:Event ] ; rr:predicateObjectMap [ rr:predicate ex:sourceId ; rr:objectMap [ rr:column "id" ] ] .
