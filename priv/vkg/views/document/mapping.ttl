@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <https://ash-r2rml.dev/vkg/document#> .
ex:DocumentMap a rr:TriplesMap ; rr:logicalTable [ rr:tableName "documents" ] ; rr:subjectMap [ rr:template "https://ash-r2rml.dev/resource/document/{id}" ; rr:class ex:Document ] ; rr:predicateObjectMap [ rr:predicate ex:sourceId ; rr:objectMap [ rr:column "id" ] ] .
