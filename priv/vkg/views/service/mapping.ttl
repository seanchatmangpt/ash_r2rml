@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <https://ash-r2rml.dev/vkg/service#> .
ex:ServiceMap a rr:TriplesMap ; rr:logicalTable [ rr:tableName "services" ] ; rr:subjectMap [ rr:template "https://ash-r2rml.dev/resource/service/{id}" ; rr:class ex:Service ] ; rr:predicateObjectMap [ rr:predicate ex:sourceId ; rr:objectMap [ rr:column "id" ] ] .
