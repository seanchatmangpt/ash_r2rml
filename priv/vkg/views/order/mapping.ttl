@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <https://ash-r2rml.dev/vkg/order#> .
ex:OrderMap a rr:TriplesMap ; rr:logicalTable [ rr:tableName "orders" ] ; rr:subjectMap [ rr:template "https://ash-r2rml.dev/resource/order/{id}" ; rr:class ex:Order ] ; rr:predicateObjectMap [ rr:predicate ex:sourceId ; rr:objectMap [ rr:column "id" ] ] .
