@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <https://ash-r2rml.dev/vkg/project#> .
ex:ProjectMap a rr:TriplesMap ; rr:logicalTable [ rr:tableName "projects" ] ; rr:subjectMap [ rr:template "https://ash-r2rml.dev/resource/project/{id}" ; rr:class ex:Project ] ; rr:predicateObjectMap [ rr:predicate ex:sourceId ; rr:objectMap [ rr:column "id" ] ] .
