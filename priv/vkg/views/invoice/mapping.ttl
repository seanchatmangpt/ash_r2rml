@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <https://ash-r2rml.dev/vkg/invoice#> .
ex:InvoiceMap a rr:TriplesMap ; rr:logicalTable [ rr:tableName "invoices" ] ; rr:subjectMap [ rr:template "https://ash-r2rml.dev/resource/invoice/{id}" ; rr:class ex:Invoice ] ; rr:predicateObjectMap [ rr:predicate ex:sourceId ; rr:objectMap [ rr:column "id" ] ] .
