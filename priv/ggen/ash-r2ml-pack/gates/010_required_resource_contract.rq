# MESSAGE: every generated AshR2ML resource requires class, module, table, subject template, and semantic identity
PREFIX ar2: <https://ash-r2ml.dev/ns#>
PREFIX sh: <http://www.w3.org/ns/shacl#>

SELECT ?shape ?missing WHERE {
  ?shape a sh:NodeShape .
  {
    FILTER NOT EXISTS { ?shape sh:targetClass ?v }
    BIND(sh:targetClass AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?shape ar2:module ?v }
    BIND(ar2:module AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?shape ar2:table ?v }
    BIND(ar2:table AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?shape ar2:subjectTemplate ?v }
    BIND(ar2:subjectTemplate AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?shape ar2:identityProperty ?v }
    BIND(ar2:identityProperty AS ?missing)
  }
}
ORDER BY ?shape ?missing
