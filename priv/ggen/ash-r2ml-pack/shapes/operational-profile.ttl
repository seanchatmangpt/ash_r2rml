@prefix ar2: <https://ash-r2ml.dev/ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ar2:OperationalNodeShapeContract a sh:NodeShape ;
  sh:targetClass sh:NodeShape ;
  sh:property [ sh:path sh:targetClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path ar2:module ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path ar2:table ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path ar2:subjectTemplate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path ar2:identityProperty ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

ar2:OperationalPropertyShapeContract a sh:NodeShape ;
  sh:targetClass sh:PropertyShape ;
  sh:property [ sh:path sh:path ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path ar2:ashName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
