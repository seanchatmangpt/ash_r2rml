@prefix ar2: <https://ash-r2ml.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ar2:OperationalNodeShape a rdfs:Class ;
  rdfs:comment "A SHACL NodeShape admitted for deterministic Ash/R2RML manufacture." .

ar2:module a rdf:Property ;
  rdfs:domain sh:NodeShape ;
  rdfs:range xsd:string ;
  rdfs:comment "Elixir module name for the generated Ash.Resource." .

ar2:table a rdf:Property ;
  rdfs:domain sh:NodeShape ;
  rdfs:range xsd:string ;
  rdfs:comment "Relational table/view name selected by the closed operational profile." .

ar2:subjectTemplate a rdf:Property ;
  rdfs:domain sh:NodeShape ;
  rdfs:range xsd:string ;
  rdfs:comment "R2RML-compatible subject template whose fields are an admitted semantic identity." .

ar2:identityProperty a rdf:Property ;
  rdfs:domain sh:NodeShape ;
  rdfs:range rdf:Property ;
  rdfs:comment "SHACL path that participates in semantic identity manufacture." .

ar2:ashName a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string ;
  rdfs:comment "Ash attribute or relationship name." .

ar2:column a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string ;
  rdfs:comment "Explicit relational source column when it differs from the Ash name." .

ar2:ashType a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string ;
  rdfs:comment "Ash type atom/module chosen by the admitted datatype projection." .

ar2:relationshipKind a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string ;
  rdfs:comment "Closed Ash relationship kind: belongs_to, has_one, has_many, or many_to_many." .

ar2:targetModule a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string ;
  rdfs:comment "Generated/known Ash module implementing the sh:class target." .

ar2:sourceKey a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string .

ar2:destinationKey a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string .

ar2:throughModule a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string .

ar2:sourceJoinAttribute a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string .

ar2:destinationJoinAttribute a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range xsd:string .

ar2:inversePredicate a rdf:Property ;
  rdfs:domain sh:PropertyShape ;
  rdfs:range rdf:Property .
