# MESSAGE: every generated AshR2RML resource requires class, module, table, subject template, and semantic identity
PREFIX r2ml: <https://seanchatmangpt.github.io/ash_r2rml#>
PREFIX sh: <http://www.w3.org/ns/shacl#>

SELECT ?shape ?missing WHERE {
  {
    ?shape a sh:NodeShape .
    MINUS { ?shape sh:targetClass ?v }
    BIND("sh:targetClass" AS ?missing)
  } UNION {
    ?shape a sh:NodeShape .
    MINUS { ?shape r2ml:ashModule ?v }
    BIND("r2ml:ashModule" AS ?missing)
  } UNION {
    ?shape a sh:NodeShape .
    MINUS { ?shape r2ml:tableName ?v }
    BIND("r2ml:tableName" AS ?missing)
  } UNION {
    ?shape a sh:NodeShape .
    MINUS { ?shape r2ml:subjectTemplate ?v }
    BIND("r2ml:subjectTemplate" AS ?missing)
  } UNION {
    ?shape a sh:NodeShape .
    MINUS { ?shape r2ml:identity ?v }
    BIND("r2ml:identity" AS ?missing)
  }
}
ORDER BY ?shape ?missing
