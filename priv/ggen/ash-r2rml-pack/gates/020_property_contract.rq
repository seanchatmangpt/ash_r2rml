# MESSAGE: every operational property needs an Ash name and either a datatype or a fully closed relationship contract
PREFIX r2ml: <https://seanchatmangpt.github.io/ash_r2rml#>
PREFIX sh: <http://www.w3.org/ns/shacl#>

SELECT ?shape ?property ?missing WHERE {
  {
    ?shape a sh:NodeShape ; sh:property ?property .
    MINUS { ?property r2ml:ashName ?v }
    BIND("r2ml:ashName" AS ?missing)
  } UNION {
    ?shape a sh:NodeShape ; sh:property ?property .
    MINUS { ?property sh:datatype ?d }
    MINUS { ?property sh:class ?t }
    BIND("sh:datatype" AS ?missing)
  } UNION {
    ?shape a sh:NodeShape ; sh:property ?property .
    ?property sh:class ?target .
    MINUS { ?property r2ml:storageStrategy ?v }
    BIND("r2ml:storageStrategy" AS ?missing)
  } UNION {
    ?shape a sh:NodeShape ; sh:property ?property .
    ?property sh:class ?target .
    MINUS { ?property r2ml:sourceKey ?v }
    BIND("r2ml:sourceKey" AS ?missing)
  } UNION {
    ?shape a sh:NodeShape ; sh:property ?property .
    ?property sh:class ?target .
    MINUS { ?property r2ml:destinationKey ?v }
    BIND("r2ml:destinationKey" AS ?missing)
  }
}
ORDER BY ?shape ?property ?missing
